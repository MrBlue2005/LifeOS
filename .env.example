# Required for Supabase Auth and Find It data access.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Public VAPID key only. Keep the matching private key server-only for Phase 2.10C.
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=

# Server-only Web Push delivery configuration. Never prefix the private key or service role key with NEXT_PUBLIC_.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:notifications@example.com
SUPABASE_SERVICE_ROLE_KEY=

# Server-only automatic Buy Later scheduler configuration. Set the rollout date
# when enabling the first production schedule to avoid sending an old backlog.
BUY_LATER_REMINDER_CRON_SECRET=
BUY_LATER_REMINDER_ROLLOUT_DATE=YYYY-MM-DD
